{
  "name": "@vlad-demchyk/package-manager",
  "version": "3.0.0-alpha.0",
  "description": "Workspace-aware dependency manager for multi-project JS/TS repositories: stack detection, compatibility checks, version alignment and vulnerability reports (SPFx, React, Node and more).",
  "type": "module",
  "bin": {
    "packman": "./bin/packman.cjs",
    "pm": "./bin/packman.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "data/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepack": "npm run build"
  },
  "keywords": [
    "package-manager",
    "monorepo",
    "multi-project",
    "dependency-management",
    "version-alignment",
    "compatibility",
    "vulnerabilities",
    "spfx",
    "sharepoint",
    "node"
  ],
  "author": "Vladyslav Demchyk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlad-demchyk/package-manager.git"
  },
  "bugs": {
    "url": "https://github.com/vlad-demchyk/package-manager/issues"
  },
  "homepage": "https://github.com/vlad-demchyk/package-manager#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "dependencies": {
    "commander": "15.0.0",
    "ink": "8.0.0",
    "jsonc-parser": "3.3.1",
    "picocolors": "1.1.1",
    "picomatch": "4.0.7",
    "react": "19.3.1",
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "@types/semver": "7.8.0",
    "eslint": "10.13.0",
    "ink-testing-library": "4.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
